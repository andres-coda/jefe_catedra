          <li>
            <?= App\Core\View::e($profesor['nombre']) ?><?php if (($profesor['email'] ?? '') !== ''): ?> — <?= App\Core\View::e((string) $profesor['email']) ?><?php endif; ?><?php if (($profesor['fecha_cese'] ?? '') !== null && ($profesor['fecha_cese'] ?? '') !== ''): ?> <span class="detalle">(cese: <?= App\Core\View::e((string) $profesor['fecha_cese']) ?>)</span><?php endif; ?>
          </li>
        <?php endforeach; ?>
      </ul>
