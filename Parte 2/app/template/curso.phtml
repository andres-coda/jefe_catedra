            <?php if ($esStaff): ?>
              <form method="post" action="<?= App\Core\Http::url('escuelas/' . $schoolId . '/cursos/' . $curso['id'] . '/links/' . $link['id']) ?>" class="en-linea">
                <input type="hidden" name="_accion" value="actualizar">
                <input type="url" name="url" maxlength="2048" value="<?= App\Core\View::e($link['url']) ?>" required>
                <input type="text" name="descripcion" maxlength="255" value="<?= App\Core\View::e((string) ($link['descripcion'] ?? '')) ?>">
                <button type="submit">Guardar</button>
              </form>
              <form method="post" action="<?= App\Core\Http::url('escuelas/' . $schoolId . '/cursos/' . $curso['id'] . '/links/' . $link['id']) ?>" class="en-linea">
                <input type="hidden" name="_accion" value="eliminar">
                <button type="submit">Eliminar</button>
              </form>
            <?php endif; ?>
          </li>
        <?php endforeach; ?>
      </ul>
