                  <button type="submit">Guardar</button>
                </form>
                <form method="post" action="<?= App\Core\Http::url('escuelas/' . $schoolId . '/cursos/' . $curso['id'] . '/tareas/' . $tarea['id'] . '/realizado') ?>" class="en-linea">
                  <input type="hidden" name="realizado" value="<?= $tarea['realizado'] === true ? '0' : '1' ?>">
