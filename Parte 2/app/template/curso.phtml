      <p>Sin tareas cargadas.</p>
    <?php else: ?>
      <table class="tabla">
        <thead>
          <tr><th>Descripción</th><th>Observaciones</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
          <?php foreach ($tareas as $tarea): ?>
            <tr>
              <td><?= App\Core\View::e($tarea['descripcion']) ?></td>
              <td><?= App\Core\View::e((string) ($tarea['observaciones'] ?? '')) ?></td>
