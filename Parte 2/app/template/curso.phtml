        <input type="text" name="descripcion" maxlength="50" required>
      </label>
      <label>Observaciones (opcional)
        <textarea name="observaciones" maxlength="255"></textarea>
      </label>
      <button type="submit">Crear tarea</button>
    </form>
  <?php endif; ?>

  <?php if ($links !== [] || $esStaff): ?>
    <h2>Enlaces de Drive</h2>
    <?php if ($links === []): ?>
      <p>Sin enlaces cargados.</p>
