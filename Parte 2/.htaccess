<IfModule mod_rewrite.c>
	RewriteEngine On

	# Archivos y directorios reales se sirven directo (CSS/JS/imágenes de estilo/).
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	# Todo lo demás va al front controller index.php.
	RewriteRule ^ index.php [QSA,L]
</IfModule>